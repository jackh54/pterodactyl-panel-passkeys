{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "panel-passkeys",
    "name": "Panel Passkeys",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Sign in to the panel with a passkey: Face ID, Touch ID, Windows Hello, a phone or a security key. Phishing-resistant, and counts as two-step on its own.",
    "author": "PandaScript",
    "provider": "PanelPasskeys\\PanelPasskeysProvider",
    "autoload": {
        "PanelPasskeys\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "ppk"
    }
}
